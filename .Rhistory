),
caption = "Tabla 2c. Selección de λ — SLICC-SDI.",
col.names = c("Criterio","λ","AUC medio CV"), align = "lcc"
) %>%
kable_styling(bootstrap_options = c("striped","hover","condensed"),
full_width = FALSE, font_size = 13)
# Aumentar margen superior para que quepan título + nº de variables
op <- par(mar = c(5, 4, 5, 2) + 0.1)
# Curva CV de glmnet sin título (lo añadimos con mtext)
plot(cv_slicc,
main = "",
xlab = "-Log(λ)",
ylab = "AUC")
# Líneas verticales para lambda.min y lambda.1se
abline(v = log(lambda_min_slicc), col = col_slicc, lty = 4, lwd = 1.5)
abline(v = log(lambda_1se_slicc),  col = "gray40",    lty = 3, lwd = 1.5)
# Título, un poco más arriba para no pisar los números superiores
mtext("CV LASSO — Remisión SLICC",
side = 3, line = 3, cex = 1.2)
# Leyenda
legend("bottomright",
legend = c("lambda.min", "lambda.1se"),
col    = c(col_slicc, "gray40"),
lty    = c(4, 3),
lwd    = 1.5,
cex    = 0.8)
# Restaurar parámetros gráficos
par(op)
modelo_slicc <- glmnet(
x = X_slicc, y = Y_slicc,
family = "binomial", alpha = 1,
lambda = lambda_1se_slicc, standardize = TRUE
)
coef_slicc    <- coef(modelo_slicc)
coef_df_slicc <- data.frame(
Variable    = rownames(coef_slicc),
Coeficiente = as.numeric(coef_slicc)
) %>%
filter(Coeficiente != 0, Variable != "(Intercept)") %>%
mutate(AbsCoef = abs(Coeficiente)) %>%
arrange(desc(AbsCoef))
cat("Variables seleccionadas (λ=1SE):", nrow(coef_df_slicc))
kable(coef_df_slicc %>% dplyr::select(Variable, Coeficiente, AbsCoef),
caption = "Tabla 3c. Coeficientes LASSO no nulos — SLICC-SDI (λ=1SE).",
col.names = c("Variable","Coeficiente","abs.Coeficiente"),
digits = 4, align = "lcc") %>%
kable_styling(bootstrap_options = c("striped","hover","condensed"),
full_width = FALSE, font_size = 13)
# Subconjunto con DORIS definido y matriz de predictores alineada
df_doris <- df
df_doris <- df_doris %>%
mutate(
Y_doris = doris_estado
)
df_slicc <- df %>%
filter(!is.na(slicc)) %>%
mutate(
Y_slicc = case_when(
slicc == 0 ~ "SinDano",
TRUE       ~ "ConDano"
),
Y_slicc = factor(Y_slicc, levels = c("SinDano", "ConDano"))
) %>%
filter(!is.na(Y_slicc))
cat("Distribución Y_slicc:\n")
print(table(df_slicc$Y_slicc))
X_slicc <- X_full[df_slicc$id2, ]
Y_slicc  <- df_slicc$Y_slicc
names(Y_slicc) <- df_slicc$id2
stopifnot(identical(rownames(X_slicc), names(Y_slicc)))
cat("N total para LASSO SLICC-SDI:", nrow(X_slicc), "\n")
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.path = "figuras/LASSO/",
dev      = "png",
dpi      = 300,
fig.width  = 8,
