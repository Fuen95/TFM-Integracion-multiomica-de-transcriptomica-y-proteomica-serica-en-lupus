filter(!is.na(doris)) %>%
mutate(
Y_doris = case_when(
as.character(doris) == "Sí" ~ "Cumple",
as.character(doris) == "No" ~ "NoCumple",
TRUE                        ~ NA_character_
),
Y_doris = factor(Y_doris, levels = c("Cumple", "NoCumple"))
) %>%
filter(!is.na(Y_doris))
